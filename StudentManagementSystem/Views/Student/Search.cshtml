@model StudentManagementSystem.Models.SearchRequest

<h2>Search Student</h2>

<form asp-action="Search" method="post">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="RegistrationNumber"></label>
        <input asp-for="RegistrationNumber" class="form-control" />
        <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Search
    </button>

</form>

@if (ViewBag.Message != null)
{
    <div class="alert alert-warning mt-3">
        @ViewBag.Message
    </div>
}

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}